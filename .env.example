# URL du serveur Ollama
BLOCAPTA_OLLAMA_URL=http://localhost:11434

# Modèle léger : extraction et validation de la fiche technique (sortie JSON structurée)
BLOCAPTA_MODEL_EXTRACTION=qwen3:8b

# Modèle plus fort : configurateur (patchs de configuration) et rédaction du rapport d'audit
BLOCAPTA_MODEL_REPORT=qwen3:8b
BLOCAPTA_MODEL_CONFIGURATOR=qwen3:8b

# Désactive le "thinking" des modèles Qwen3 (réponses plus rapides, JSON plus propre)
BLOCAPTA_OLLAMA_THINK=false
BLOCAPTA_OLLAMA_TIMEOUT=300

# Si false, BLOCAPTA fonctionne sans LLM (rapport déterministe, pas d'extraction de PDF)
BLOCAPTA_LLM_ENABLED=true
